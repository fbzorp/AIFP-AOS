# Production Environment Configuration Example
# Copy this file to .env.production and fill in actual values
# DO NOT commit .env.production with real credentials

# Application Settings
APP_ENV=production
SECRET_KEY=your-random-secret-key-here
LOG_LEVEL=INFO

# Database
POSTGRES_USER=aifp
POSTGRES_PASSWORD=your-strong-database-password-here
POSTGRES_DB=aifp_prod
DATABASE_URL=postgresql+asyncpg://aifp:your-strong-database-password-here@postgres:5432/aifp_prod

# Redis
REDIS_URL=redis://redis:6379/0

# AI / LLM (Required)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_PRIMARY_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
DAILY_LLM_BUDGET_USD=25.00

# Moltbook / Social (Required if MOLTBOOK_AUTOPUBLISH=true)
MOLTBOOK_BASE_URL=https://www.moltbook.com
MOLTBOOK_API_KEY=your-moltbook-api-key-here
MOLTBOOK_AGENT_API_KEY=your-moltbook-agent-api-key-here
MOLTBOOK_APP_KEY=your-moltbook-app-key-here
MOLTBOOK_AUTOPUBLISH=false
MOLTBOOK_ALLOWED_SUBMOLTS=general,aifintech,aiagents

# X / Twitter (Required if X_AUTOPUBLISH=true)
X_API_KEY=your-x-api-key-here
X_API_SECRET=your-x-api-secret-here
X_ACCESS_TOKEN=your-x-access-token-here
X_ACCESS_TOKEN_SECRET=your-x-access-token-secret-here
X_AUTOPUBLISH=false

# Telegram (Required if TELEGRAM_AUTOPUBLISH=true)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_AUTOPUBLISH=false
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
TELEGRAM_DEFAULT_CHANNEL=your-telegram-default-channel-here

# SEO / Multi-channel publishing
SEO_MULTI_CHANNEL_AUTOPUBLISH=false

# Agent-Specific Credentials (Optional)
# Founder Content Agent
FOUNDER_CONTENT_X_API_KEY=
FOUNDER_CONTENT_X_API_SECRET=
FOUNDER_CONTENT_X_ACCESS_TOKEN=
FOUNDER_CONTENT_X_ACCESS_TOKEN_SECRET=
FOUNDER_CONTENT_X_AUTOPUBLISH=false
FOUNDER_CONTENT_TELEGRAM_BOT_TOKEN=
FOUNDER_CONTENT_TELEGRAM_CHAT_ID=
FOUNDER_CONTENT_TELEGRAM_AUTOPUBLISH=false
FOUNDER_CONTENT_TELEGRAM_DEFAULT_CHANNEL=
FOUNDER_CONTENT_MOLTBOOK_AGENT_API_KEY=
FOUNDER_CONTENT_MOLTBOOK_APP_KEY=
FOUNDER_CONTENT_MOLTBOOK_AUTOPUBLISH=false

# Technical Content Agent
TECHNICAL_CONTENT_X_API_KEY=
TECHNICAL_CONTENT_X_API_SECRET=
TECHNICAL_CONTENT_X_ACCESS_TOKEN=
TECHNICAL_CONTENT_X_ACCESS_TOKEN_SECRET=
TECHNICAL_CONTENT_X_AUTOPUBLISH=false
TECHNICAL_CONTENT_TELEGRAM_BOT_TOKEN=
TECHNICAL_CONTENT_TELEGRAM_CHAT_ID=
TECHNICAL_CONTENT_TELEGRAM_AUTOPUBLISH=false
TECHNICAL_CONTENT_TELEGRAM_DEFAULT_CHANNEL=
TECHNICAL_CONTENT_MOLTBOOK_AGENT_API_KEY=
TECHNICAL_CONTENT_MOLTBOOK_APP_KEY=
TECHNICAL_CONTENT_MOLTBOOK_AUTOPUBLISH=false

# SEO Content Agent
SEO_CONTENT_X_API_KEY=
SEO_CONTENT_X_API_SECRET=
SEO_CONTENT_X_ACCESS_TOKEN=
SEO_CONTENT_X_ACCESS_TOKEN_SECRET=
SEO_CONTENT_X_AUTOPUBLISH=false
SEO_CONTENT_TELEGRAM_BOT_TOKEN=
SEO_CONTENT_TELEGRAM_CHAT_ID=
SEO_CONTENT_TELEGRAM_AUTOPUBLISH=false
SEO_CONTENT_TELEGRAM_DEFAULT_CHANNEL=
SEO_CONTENT_MOLTBOOK_AGENT_API_KEY=
SEO_CONTENT_MOLTBOOK_APP_KEY=
SEO_CONTENT_MOLTBOOK_AUTOPUBLISH=false
SEO_CONTENT_MULTI_CHANNEL_AUTOPUBLISH=false

# Social Publishing Agent
SOCIAL_PUBLISHING_AGENT_X_API_KEY=
SOCIAL_PUBLISHING_AGENT_X_API_SECRET=
SOCIAL_PUBLISHING_AGENT_X_ACCESS_TOKEN=
SOCIAL_PUBLISHING_AGENT_X_ACCESS_TOKEN_SECRET=
SOCIAL_PUBLISHING_AGENT_X_AUTOPUBLISH=false
SOCIAL_PUBLISHING_AGENT_TELEGRAM_BOT_TOKEN=
SOCIAL_PUBLISHING_AGENT_TELEGRAM_CHAT_ID=
SOCIAL_PUBLISHING_AGENT_TELEGRAM_AUTOPUBLISH=false
SOCIAL_PUBLISHING_AGENT_TELEGRAM_DEFAULT_CHANNEL=
SOCIAL_PUBLISHING_AGENT_MOLTBOOK_AGENT_API_KEY=
SOCIAL_PUBLISHING_AGENT_MOLTBOOK_APP_KEY=
SOCIAL_PUBLISHING_AGENT_MOLTBOOK_AUTOPUBLISH=false

# Community Engagement Agent
COMMUNITY_ENGAGEMENT_AGENT_X_API_KEY=
COMMUNITY_ENGAGEMENT_AGENT_X_API_SECRET=
COMMUNITY_ENGAGEMENT_AGENT_X_ACCESS_TOKEN=
COMMUNITY_ENGAGEMENT_AGENT_X_ACCESS_TOKEN_SECRET=
COMMUNITY_ENGAGEMENT_AGENT_X_AUTOPUBLISH=false
COMMUNITY_ENGAGEMENT_AGENT_TELEGRAM_BOT_TOKEN=
COMMUNITY_ENGAGEMENT_AGENT_TELEGRAM_CHAT_ID=
COMMUNITY_ENGAGEMENT_AGENT_TELEGRAM_AUTOPUBLISH=false
COMMUNITY_ENGAGEMENT_AGENT_TELEGRAM_DEFAULT_CHANNEL=
COMMUNITY_ENGAGEMENT_AGENT_MOLTBOOK_AGENT_API_KEY=
COMMUNITY_ENGAGEMENT_AGENT_MOLTBOOK_APP_KEY=
COMMUNITY_ENGAGEMENT_AGENT_MOLTBOOK_AUTOPUBLISH=false

# News/Search APIs
NEWS_API_KEY=your-news-api-key-here
SERPER_API_KEY=your-serper-api-key-here

# SEO Pages (Static HTML publishing)
SEO_PAGES_OUTPUT_DIR=/var/www/html/seo
SEO_PAGES_BASE_URL=https://your-domain.com/blog
SEO_INDEXNOW_KEY=your-indexnow-api-key-here

# Domain configuration for SSL/TLS
DOMAIN=your-domain.com
# For Let's Encrypt SSL certificates, ensure:
# 1. DOMAIN is set to your actual domain
# 2. DNS A record points to your server IP
# 3. Port 80 and 443 are accessible from the internet
# 4. Certbot service will automatically obtain and renew certificates

# Monitoring and Alerting
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password

# Email Alerts (optional)
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USER=your-email@gmail.com
ALERT_EMAIL_SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=alerts@your-domain.com

# Telegram Alerts (optional)
ALERT_TELEGRAM_ENABLED=false
ALERT_TELEGRAM_BOT_TOKEN=your-bot-token
ALERT_TELEGRAM_CHAT_ID=your-chat-id

# Webhook Alerts (optional)
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=https://your-webhook-url.com/alerts

# Backup Configuration
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=/backups
