APP_ENV=development
DEEPSEEK_API_KEY=sk-replace_me_with_real_key
DEEPSEEK_PRIMARY_MODEL=deepseek/deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek/deepseek-v4-pro
DEEPSEEK_API_BASE=https://api.deepseek.com
MOLTBOOK_BASE_URL=https://www.moltbook.com
MOLTBOOK_AGENT_API_KEY=replace_me
MOLTBOOK_APP_KEY=moltdev_replace_me
MOLTBOOK_AUTOPUBLISH=false
MOLTBOOK_ALLOWED_SUBMOLTS=general,agents,introductions,aifintech
HTTP_TIMEOUT_SECONDS=20
DAILY_LLM_BUDGET_USD=25
DATABASE_URL=postgresql+asyncpg://aifp:devpassword@postgres:5432/aifp_dev
REDIS_URL=redis://redis:6379/0

# Payment Safety Settings
HUMAN_APPROVAL_THRESHOLD=50.0
PER_TRANSACTION_LIMIT=50.0
DAILY_SPENDING_LIMIT=100.0
PAYMENTS_NETWORK=devnet
X402_ENABLED=true
X402_FACILITATOR_URL=https://api.aifinpay.io
SOLANA_PRIVATE_KEY=replace_me_base58_solana_private_key
EVM_PRIVATE_KEY=replace_me_evm_private_key
SOLANA_RPC_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
EVM_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
RECIPIENT_ALLOWLIST=replace_me_with_comma_separated_addresses
PAYMENTS_KILL_SWITCH=false

# AiFinPay Integration
AIFP_BASE_URL=https://api.aifinpay.io
AIFINPAY_AGENT_SECRET=replace_me_base58_ed25519_secret
AIFINPAY_AGENT_PUBKEY=replace_me_ed25519_pubkey
AIFINPAY_MAX_USD=0.10
AIFINPAY_MCP_ENABLED=true
