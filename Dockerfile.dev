# syntax=docker/dockerfile:1
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir uv
# Install Node.js for npx @aifinpay/mcp stdio transport
RUN apt-get update -y && apt-get install -y --fix-missing curl nodejs npm && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --all-groups
COPY . .
RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser
ENV UV_CACHE_DIR=/home/appuser/.cache/uv
CMD ["uv", "run", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
